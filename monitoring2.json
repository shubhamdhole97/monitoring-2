      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (instance, node) (0 * node_memory_MemTotal_bytes{instance=~\"$node_instance\",node!=\"\"} + 1) or on (instance) max by (instance, node) (label_replace(node_uname_info{instance=~\"$node_instance\"}, \"node\", \"$1\", \"nodename\", \"(.+)\"))",
          "refId": "node_info",
          "hide": false,
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{instance=~\"$node_instance\",mode=\"idle\"}[$__rate_interval])))",
          "refId": "cpu_percent",
          "hide": false,
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(1 - avg by (instance) (rate(node_cpu_seconds_total{instance=~\"$node_instance\",mode=\"idle\"}[$__rate_interval]))) * (count by (instance) (count by (instance, cpu) (node_cpu_seconds_total{instance=~\"$node_instance\",mode=\"idle\"})))",
          "refId": "cpu_used",
          "hide": false,
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count by (instance) (count by (instance, cpu) (node_cpu_seconds_total{instance=~\"$node_instance\",mode=\"idle\"}))",
          "refId": "cpu_total",
          "hide": false,
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * (1 - (max by (instance) (node_memory_MemAvailable_bytes{instance=~\"$node_instance\"})) / (max by (instance) (node_memory_MemTotal_bytes{instance=~\"$node_instance\"})))",
          "refId": "memory_percent",
          "hide": false,
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(max by (instance) (node_memory_MemTotal_bytes{instance=~\"$node_instance\"})) - (max by (instance) (node_memory_MemAvailable_bytes{instance=~\"$node_instance\"}))",
          "refId": "memory_used",
          "hide": false,
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (instance) (node_memory_MemAvailable_bytes{instance=~\"$node_instance\"})",
          "refId": "memory_available",
          "hide": false,
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (instance) (node_memory_MemTotal_bytes{instance=~\"$node_instance\"})",
          "refId": "memory_total",
          "hide": false,
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * (1 - min by (instance) (node_filesystem_avail_bytes{instance=~\"$node_instance\",mountpoint!~\".*(serviceaccount|proc|sys).*\",device!=\"overlay\",fstype!~\"tmpfs|devtmpfs|squashfs|overlay\"} / (node_filesystem_size_bytes{instance=~\"$node_instance\",mountpoint!~\".*(serviceaccount|proc|sys).*\",device!=\"overlay\",fstype!~\"tmpfs|devtmpfs|squashfs|overlay\"} > 0)))",
          "refId": "storage",
          "hide": false,
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "title": "Kubernetes Nodes - CPU and Memory",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #node_info": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "Time 9": true
            },
            "indexByName": {
              "node": 0,
              "instance": 1,
              "Value #cpu_percent": 2,
              "Value #cpu_used": 3,
              "Value #cpu_total": 4,
              "Value #memory_percent": 5,
              "Value #memory_used": 6,
              "Value #memory_available": 7,
              "Value #memory_total": 8,
              "Value #storage": 9
            },
            "renameByName": {
              "node": "Node",
              "instance": "Instance",
              "Value #cpu_percent": "CPU Usage %",
              "Value #cpu_used": "CPU Used (cores)",
              "Value #cpu_total": "CPU Total (cores)",
              "Value #memory_percent": "Memory Usage %",
              "Value #memory_used": "Memory Used",
              "Value #memory_available": "Memory Available",
              "Value #memory_total": "Memory Total",
              "Value #storage": "Filesystem Usage %"
            }
          }
        }
      ],
      "type": "table",
      "description": "One row per node-exporter instance. Node uses the Kubernetes node label when present, otherwise the optional node_uname_info hostname. Instance is the Prometheus scrape target. CPU usage is non-idle time; CPU cores are logical CPUs. Memory used = MemTotal - MemAvailable, including non-reclaimable kernel memory. Memory values display in IEC units (GiB). Filesystem usage is 100 * (1 - available/size) for the most utilized included filesystem. These are host metrics and can differ from kubectl top nodes."
